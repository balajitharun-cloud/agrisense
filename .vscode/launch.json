{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug AgriSense backend",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/src/server.js",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "restart": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Run backend smoke test",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/scripts/smoke.mjs",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}