# ---------------------------------------------------------------------------
# AgriSense backend - environment configuration
# Copy to `.env` and fill in. Every integration degrades gracefully:
# if a key is missing, the server returns realistic MOCK data and sets
# `"source": "mock"` in the response so the UI can label it.
# ---------------------------------------------------------------------------

PORT=8787

# --- Voice (ElevenLabs) ----------------------------------------------------
# https://elevenlabs.io  -> Profile -> API key
ELEVENLABS_API_KEY=
# Default voice id ("Rachel" is a safe public default)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Weather ---------------------------------------------------------------
# Open-Meteo needs NO key (used by default).
# Optional OpenWeatherMap key to switch providers:
OPENWEATHER_API_KEY=

# --- Satellite / soil ------------------------------------------------------
# Sentinel Hub / Copernicus credentials (optional; mock NDVI used otherwise)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# --- Marketplace -----------------------------------------------------------
# Optional marketplace backend (AgMarkNet / eNAM proxy or your own)
MARKETPLACE_API_BASE=
MARKETPLACE_API_KEY=

# --- Government announcements ---------------------------------------------
# Optional RSS/JSON feed for real gov advisories (mock feed used otherwise)
GOV_FEED_URL=

# --- Translation -----------------------------------------------------------
# Optional machine-translation provider key (server ships a curated dictionary)
TRANSLATE_API_KEY=
